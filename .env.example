# Copy to .env.local for local work. In Vercel, add each one under Project > Settings > Environment Variables.
# NEVER commit real values.

# Public site URL. Used for canonical URLs, OG tags, the sitemap and Stripe return URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Contact address shown on the site (defaults to info@blackwellen.com)
NEXT_PUBLIC_CONTACT_EMAIL=

# Stripe. TEST keys until the owner approves go-live.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price created by scripts/stripe-setup.mjs (lookup key linewise_ebook_gbp_1999)
STRIPE_PRICE_ID=
# "true" once Stripe Tax is active in the account
STRIPE_AUTOMATIC_TAX=true
# Live keys are refused unless this is "true". Only set it at go-live.
STRIPE_ALLOW_LIVE=

# Signs order download links. 32+ random characters, for example: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
DOWNLOAD_TOKEN_SECRET=
# Optional overrides (defaults: 30 days, 15 downloads, 600-second presigned URLs)
DOWNLOAD_LINK_DAYS=
DOWNLOAD_MAX=
DOWNLOAD_URL_TTL_SECONDS=

# Cloudflare R2 (private bucket "linewise-products"). An S3 API token with Object Read on that bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=linewise-products

# Optional: Resend for the download email and the free-sample mailing list
RESEND_API_KEY=
RESEND_FROM=
RESEND_AUDIENCE_ID=
